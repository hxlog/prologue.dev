# =============================================================================
# prologue.dev — environment template
# Copy to .env.local and fill in. `.env` and `.env.*` are gitignored.
# =============================================================================

# --- Postgres: pooled (PgBouncer, transaction mode) --------------------------
# Application traffic. pool_mode MUST be `transaction`.
DATABASE_URL="postgres://USER:PASSWORD@HOST:6432/prologue"

# --- Postgres: direct (no pooler) --------------------------------------------
# Migrations, scripts, psql. Never used by request handlers.
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST:5432/prologue"

# Optional TLS. Certificate verification is ON by default; if the server has a
# self-signed cert, point DATABASE_SSL_CA at its PEM rather than disabling
# verification.
# DATABASE_SSL=require
# DATABASE_SSL_CA=/path/to/ca.pem

# Pool ceiling per function instance. Keep small: the cluster's
# max_connections is shared with other databases.
# PG_POOL_MAX=3

# --- Auth --------------------------------------------------------------------
# 32+ byte base64url random. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Canonical origin. Required in production: __Host- cookies are Secure-only and
# are silently dropped on http://localhost, so local development omits the
# prefix (see PROLOGUE_ALLOW_INSECURE_COOKIE).
BETTER_AUTH_URL="https://prologue.dev"

# The only account permitted to exist. Enforced in the sign-up path.
OWNER_EMAIL=""

# Set to "1" to drop the __Host- cookie prefix for local http development.
# Never set this in production.
# PROLOGUE_ALLOW_INSECURE_COOKIE=1

# --- Vercel Blob (PRIVATE store) ---------------------------------------------
# The store MUST be private. Media is served through /api/img/<pathname>, which
# decides per request whether the requester may have the object; a public store
# would serve everything to anyone holding a URL and make /studio/media a list
# of every screenshot ever uploaded, including the ones in drafts that never
# shipped. `scripts/studio/blob-probe.mjs` asserts the 403 that proves it.
#
# Both values are read from the environment by the SDK. BLOB_STORE_ID is only
# needed for OIDC on Vercel; the read-write token covers local development.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# --- Analytics (umami, same host as the database) ----------------------------
# Read-only, and only for the per-post view counts shown inside /studio.
# Never rendered on the public site.
UMAMI_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/umami"
UMAMI_WEBSITE_ID=""

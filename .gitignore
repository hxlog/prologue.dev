# vercel
.vercel

# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/

# Obsidian vault state — local only, never committed, must never reach the template
/.obsidian/
/data/.obsidian/

# OpenIDE per-user state — local only, never committed
/.openidea/

# generated search index (rebuilt on every build; must not ship to the template snapshot)
/public/search-index.json
/public/search-index-lite.json
# generated responsive thumbnails (rebuilt by scripts/build-image-variants.mjs)
/public/static/variants/

# Playwright artifacts
/test-results/
/playwright-report/

# publish worktree
/.tmp/

# Playwright MCP scratch (screenshots, console logs) — local only
/.playwright-mcp/

# yarn, not using zero-installs
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

.env

# scratch file used to hold multi-line git commit messages
commit-msg.tmp

# static export output + Cloudflare / generated OG artifacts
/out/
/.wrangler/
/public/og/
/data/og-manifest.js
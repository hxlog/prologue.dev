{
  "name": "Prologue Blog",
  "version": "1.0.0",
  "scripts": {
    "dev": "contentlayer2 build && node scripts/build-search-index.mjs && concurrently -k -n content,next -c blue,green \"contentlayer2 dev\" \"next dev --turbopack\"",
    "build": "contentlayer2 build && node scripts/build-search-index.mjs && next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "build:content": "contentlayer2 build && node scripts/build-search-index.mjs",
    "publish:dry": "node scripts/publish-template.mjs",
    "publish": "node scripts/publish-template.mjs --publish"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/postcss": "^4.3.3",
    "contentlayer2": "^0.5.8",
    "date-fns": "^4.4.0",
    "feed": "^6.0.0",
    "framer-motion": "^13.2.0",
    "fuse.js": "^7.5.0",
    "hast-util-whitespace": "^3.0.0",
    "hastscript": "^9.0.1",
    "js-yaml": "^5.4.1",
    "mermaid": "^11.17.2",
    "next": "^16.3.4",
    "next-contentlayer2": "^0.5.8",
    "next-themes": "^0.4.6",
    "pako": "^3.0.1",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.5",
    "eslint": "^10",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "shiki": "^4.4.3"
  }

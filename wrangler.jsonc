{
  // Cloudflare Workers Static Assets deploy target for the full-static export.
  // Assets-only Worker: no main, no script, no assets binding. yarn export writes
  // ./out; scripts/build-cf-assets.mjs adds _headers, _redirects and the flattened
  // RSC payload paths before wrangler uploads the directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prologue-blog",
  "compatibility_date": "2026-11-24",
  // No workers.dev hostname in production: both public hostnames are Custom
  // Domains. The preview hostname (cf.prologue.dev) was removed at cutover.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "prologue.dev", "custom_domain": true },
    { "pattern": "www.prologue.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}